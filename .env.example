# 배포 경로. 저장소 페이지면 /<repo>/, 커스텀 도메인이면 /
VITE_BASE=/

# 문의 게시판 → 메일 전송 서비스 (Web3Forms 또는 Formspree)
# 비워두면 mailto(방문자 메일 앱) 방식으로 대체됩니다.
#   Web3Forms : VITE_CONTACT_ENDPOINT=https://api.web3forms.com/submit , ACCESS_KEY 필요
#   Formspree : VITE_CONTACT_ENDPOINT=https://formspree.io/f/<폼ID>   , ACCESS_KEY 불필요
VITE_CONTACT_ENDPOINT=
VITE_CONTACT_ACCESS_KEY=
